# Zeilenenden normalisieren (deterministische Text-Diffs) -----------------
* text=auto eol=lf
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.cfg   text eol=lf
*.godot text eol=lf

# Git-LFS fuer Binaer-Assets (Serien-Handbuch §2.3) -----------------------
# Aktiviert ab Phase 6 (Art & Audio). Bis dahin existieren keine Binaerdateien.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text

# SVG bleibt Text (Ikon-Pipeline arbeitet quelloffen) ---------------------
*.svg text eol=lf
