{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threat.schema.json",
  "title": "Beutenjahr Bedrohung",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name_key", "hp", "act", "intents"],
  "properties": {
    "id": { "$ref": "defs.schema.json#/$defs/id" },
    "name_key": { "$ref": "defs.schema.json#/$defs/key" },
    "text_key": { "$ref": "defs.schema.json#/$defs/key" },
    "hp": { "type": "integer", "minimum": 1 },
    "act": { "$ref": "defs.schema.json#/$defs/act" },
    "is_boss": { "type": "boolean" },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["per_turn", "per_phase", "none"] },
        "value": { "type": "integer", "minimum": 0 }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight", "effects"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/id" },
          "weight": { "type": "integer", "minimum": 1 },
          "min_turn": { "type": "integer", "minimum": 1 },
          "phase": { "type": "integer", "minimum": 1 },
          "effects": { "$ref": "defs.schema.json#/$defs/effect_list" }
        }
      }
    }
  }
}
